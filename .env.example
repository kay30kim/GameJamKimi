# Copy to .env.local and fill in. Never commit .env.local.
KIMI_API_KEY=
# Korean, mixed, and English lines default to the ElevenLabs multilingual cast.
TTS_KOREAN_PROVIDER=elevenlabs
# Optional auditioned Typecast cast. Set TTS_KOREAN_PROVIDER=typecast only after
# the provider has cleared any account restriction; failures fall back to ElevenLabs.
# Get API voice IDs with npm run voices:list; Studio actor IDs are different.
TYPECAST_API_KEY=
TYPECAST_MODEL=ssfm-v31
# Optional overrides; blank values use the reviewed cast in lib/typecast.ts.
TYPECAST_VOICE_NARRATOR=
TYPECAST_VOICE_HERO=
TYPECAST_VOICE_FRIEND=
TYPECAST_VOICE_PUPPY=
TYPECAST_VOICE_GROWNUP=
TYPECAST_VOICE_KITTEN=
TYPECAST_VOICE_DUCK=
# Multilingual cast (required for default Korean and English playback).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=Ov7OTdKIPpevrpNdUZRz
# Set to 1 to play the game client against mocks/scene.json instead of /api/scene.
NEXT_PUBLIC_USE_MOCK_SCENE=

# Optional private cloud storage for generated scenes and MP3s. Connect a private
# Vercel Blob store to this project; Vercel injects BLOB_STORE_ID and OIDC credentials.
# Outside Vercel, use a server-only read/write token for that same private store.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
# Without Blob credentials, local development persists under .cache/generated/.
# Optional local cache root (default .cache); entries go in <root>/generated/v1/.
GENERATED_CACHE_DIR=
# Set 1 to bypass all stored generated content, useful while debugging prompts.
GENERATED_CACHE_DISABLED=
